# Copy to .env.local and fill in real values. Restart `npm run dev` after changes.

# Public site URL (used for SEO metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://fouretdelicesdakar.com

# --- Resend (domain verified on resend.com/domains) ---
RESEND_API_KEY=re_xxxxxxxx
# Use an address on YOUR verified domain (not onboarding@resend.dev)
RESEND_FROM_EMAIL=Four et Délices <orders@fouretdelicesdakar.com>

# Owner inbox — new inquiry notification
OWNER_EMAIL=fouretdelices@gmail.com

# --- Meta WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
